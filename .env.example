# Copy to .env.local. Every variable must have a one-line purpose. Never commit real values.

# --- Access control (Phase 0 private alpha) ---
ALPHA_BASIC_AUTH_USER=            # shared credential for the basic-auth gate
ALPHA_BASIC_AUTH_PASS=            # its password; long and random (no rate limiting until T4.2)

# --- Database (portable Postgres; see ADR-0003) ---
DATABASE_URL=                     # server-side connection string; never exposed to the browser

# --- Hashing (for VIN/IP hashes in logs; rotate = old logs become unlinkable, which is fine) ---
LOG_HASH_SALT=

# --- Providers (see ADR-0005; only contracted or public endpoints) ---
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/
NMVTIS_RESELLER_API_KEY=          # sandbox key in Phase 0
NMVTIS_RESELLER_BASE_URL=
AUCTION_VENDOR_ENABLED=false      # stays false until a rights warranty + indemnity is signed
AUCTION_VENDOR_API_KEY=
AUCTION_VENDOR_BASE_URL=

# --- Email (transactional only; provider must have a DPA) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=                       # e.g. reports@yourdomain.ae

# --- Payments (gateway-hosted pages only; test mode until the entity exists) ---
PAYMENTS_ENABLED=false
GATEWAY_SECRET_KEY=
GATEWAY_WEBHOOK_SECRET=

# --- Deployment ---
VERCEL_FUNCTION_REGION=dxb1       # fallback region configured in vercel.json
